# cp .env.example .env 후 값을 채우세요.

# DB (compose의 db 컨테이너와 앱이 함께 사용)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=the_labot

# 호스트 3306이 이미 쓰일 때만
#MYSQL_PORT=3307

# JWT (32바이트 이상)
JWT_SECRET_KEY=

# AWS S3 — 파일 업로드/조회
IAM_ACCESS_KEY=
IAM_SECRET_KEY=
S3_BUCKET_NAME=

# NCP CLOVA OCR — 근로계약서/신분증 인식 (선택)
NCP_OCR_INVOKE_URL=
NCP_OCR_SECRET_KEY=
NCP_OCR_IDCARD_URL=
NCP_OCR_IDCARD_KEY=

# solapi — 임시 비밀번호 SMS 발송 (선택)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
SOLAPI_API_URL=https://api.solapi.com/messages/v4/send
